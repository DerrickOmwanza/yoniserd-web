# YoNISeRD website — environment variables
# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables.

# Resend API key (https://resend.com → API Keys). Required for the contact form in production.
RESEND_API_KEY=

# Where contact-form messages are delivered (defaults to the address in src/content/site.ts).
CONTACT_TO_EMAIL=youthnetwork4@gmail.com

# Sender shown on notification emails. Must use a domain verified in Resend.
# Until yoniserd.co.ke is verified, leave empty to use Resend's test sender
# (which only delivers to the email address that owns the Resend account).
CONTACT_FROM_EMAIL="YoNISeRD Website <website@yoniserd.co.ke>"
